{
  "rewrites": [
    {
      "source": "/claude.txt",
      "destination": "/api/brief"
    }
  ],
  "headers": [
    {
      "source": "/latest.html",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"CLHTML.html\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
